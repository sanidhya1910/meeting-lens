{
  "name": "meeting-lens-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Native desktop shell for Meeting Lens (manages the local backend + UI).",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env ELECTRON_DEV=1 electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.meetinglens.app",
    "productName": "Meeting Lens",
    "files": ["main.js", "package.json"],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg", "category": "public.app-category.productivity" },
    "linux": { "target": "AppImage", "category": "Office" }
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
